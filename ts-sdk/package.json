{
  "name": "@matchbook/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the MatchBook on-chain order book on Solana: instructions, market decoding, quotes and events",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "matchbook",
    "solana",
    "clob",
    "orderbook",
    "dex",
    "trading",
    "sdk"
  ],
  "author": "Joaquin Bejar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaquinbejar/matchbook.git",
    "directory": "ts-sdk"
  },
  "peerDependencies": {
    "@solana/kit": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "litesvm": "^1.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
