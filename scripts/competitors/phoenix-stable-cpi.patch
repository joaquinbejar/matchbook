diff --git a/src/program/stable_cpi.rs b/src/program/stable_cpi.rs
new file mode 100644
index 0000000..3b00d1b
--- /dev/null
+++ b/src/program/stable_cpi.rs
@@ -0,0 +1,111 @@
+//! CPI through the stable instruction layout the runtime expects; solana-program 1.14
+//! passes `Instruction` with whatever `Vec` layout the compiler picks.
+use solana_program::{
+    account_info::AccountInfo, entrypoint::ProgramResult, instruction::{AccountMeta, Instruction},
+    pubkey::Pubkey,
+};
+
+#[repr(C)]
+struct StableVec<T> {
+    ptr: *const T,
+    cap: usize,
+    len: usize,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct StableAccountInfo {
+    key: *const Pubkey,
+    lamports: usize,
+    data: usize,
+    owner: *const Pubkey,
+    rent_epoch: u64,
+    is_signer: bool,
+    is_writable: bool,
+    executable: bool,
+}
+
+#[repr(C)]
+struct StableInstruction {
+    accounts: StableVec<AccountMeta>,
+    data: StableVec<u8>,
+    program_id: Pubkey,
+}
+
+#[cfg(target_os = "solana")]
+extern "C" {
+    fn sol_invoke_signed_rust(
+        instruction_addr: *const u8,
+        account_infos_addr: *const u8,
+        account_infos_len: u64,
+        signers_seeds_addr: *const u8,
+        signers_seeds_len: u64,
+    ) -> u64;
+}
+
+pub fn invoke(instruction: &Instruction, account_infos: &[AccountInfo]) -> ProgramResult {
+    invoke_signed(instruction, account_infos, &[])
+}
+
+pub fn invoke_signed(
+    instruction: &Instruction,
+    account_infos: &[AccountInfo],
+    signers_seeds: &[&[&[u8]]],
+) -> ProgramResult {
+    for meta in instruction.accounts.iter() {
+        for info in account_infos.iter() {
+            if meta.pubkey == *info.key {
+                if meta.is_writable {
+                    let _ = info.try_borrow_mut_lamports()?;
+                    let _ = info.try_borrow_mut_data()?;
+                } else {
+                    let _ = info.try_borrow_lamports()?;
+                    let _ = info.try_borrow_data()?;
+                }
+                break;
+            }
+        }
+    }
+    let ix = StableInstruction {
+        accounts: StableVec {
+            ptr: instruction.accounts.as_ptr(),
+            cap: instruction.accounts.capacity(),
+            len: instruction.accounts.len(),
+        },
+        data: StableVec {
+            ptr: instruction.data.as_ptr(),
+            cap: instruction.data.capacity(),
+            len: instruction.data.len(),
+        },
+        program_id: instruction.program_id,
+    };
+    let infos: Vec<StableAccountInfo> = account_infos
+        .iter()
+        .map(|a| StableAccountInfo {
+            key: a.key as *const Pubkey,
+            lamports: unsafe { core::mem::transmute_copy(&a.lamports) },
+            data: unsafe { core::mem::transmute_copy(&a.data) },
+            owner: a.owner as *const Pubkey,
+            rent_epoch: a.rent_epoch,
+            is_signer: a.is_signer,
+            is_writable: a.is_writable,
+            executable: a.executable,
+        })
+        .collect();
+    #[cfg(not(target_os = "solana"))]
+    let result: u64 = { let _ = (&ix, &infos, signers_seeds); 0 };
+    #[cfg(target_os = "solana")]
+    let result = unsafe {
+        sol_invoke_signed_rust(
+            &ix as *const _ as *const u8,
+            infos.as_ptr() as *const u8,
+            account_infos.len() as u64,
+            signers_seeds as *const _ as *const u8,
+            signers_seeds.len() as u64,
+        )
+    };
+    match result {
+        0 => Ok(()),
+        _ => Err(result.into()),
+    }
+}
